# Upstream Garage Trip Chores API
CHORES_API_BASE=https://chores.garage-trip.cz
CHORES_WS_URL=wss://chores.garage-trip.cz/ws
CHORES_API_KEY=your-api-key-here

# Local app
# Persistence backend: "sqlite" (local file) now; "api" arrives in Phase 3.
STORE_BACKEND=sqlite
DB_PATH=chores.db
# Number of little children at the retreat (add to workload, not assignable)
CHILDREN_COUNT=5

# --- Discord OAuth (Phase 1) ---
# Create an app at https://discord.com/developers/applications
# Add the callback URL under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8000/auth/discord/callback

# Bot token + guild id are used to read a member's roles for gating.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Role names (leave blank to skip that gate). Paid gates login.
DISCORD_PAID_ROLE=
DISCORD_ADMIN_ROLE=
DISCORD_PRESENT_ROLE=

# Sign the session cookie; use a long random string in production.
SESSION_SECRET=change-this-to-a-random-string
# Shared password so the TV/tablet can open /dashboard without OAuth.
TABLET_PASSWORD=
# Require a login for the app pages. Off by default while OAuth is set up.
AUTH_REQUIRED=false
